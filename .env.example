# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ziggle_chatbot
DB_SSL=false
# DB_SSL=true일 때 서버 인증서 검증 방식. 운영 배포에서는 아래 중 하나를 반드시 지정한다.
#   DB_SSL_CA                      : 신뢰할 CA 인증서(PEM). 검증을 켜고 이 CA를 신뢰한다. (권장)
#   DB_SSL_REJECT_UNAUTHORIZED=true: CA를 따로 주지 않고 검증만 켠다.
#   DB_SSL_REJECT_UNAUTHORIZED=false: 검증하지 않는다. 자체 서명 인증서를 쓸 때만 명시적으로 선택한다.
# 셋 다 비어 있으면 검증하지 않으며, 기동 시 경고가 남는다.
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# 프로덕션 배포 시 반드시 변경하세요 (최소 32자 이상)
JWT_SECRET=your-jwt-secret-change-me-at-least-32-characters-long
JWT_EXPIRES_IN=3600

# Admin Authentication
# 프로덕션 배포 시 반드시 변경하세요 (최소 16자 이상)
ADMIN_BEARER_TOKEN=your-admin-token-change-me-at-least-16-chars

# Infoteam IDP Configuration
IDP_URL=https://account.gistory.me
IDP_CLIENT_ID=your_client_id
IDP_CLIENT_SECRET=your_client_secret

# Client Domain Url (프로토콜 영역 미포함)
DOMAIN_NAME=example.com

# MCP Server Url
MCP_BASE_URL=your-mcp-server-url
MCP_RESOURCE_API_URL=your-mcp-resource-api-url

# GCS (PDF processor)
GCS_BUCKET=gcs-bucket-name
GCP_PROJECT_ID=gcp-project-id
# GCP 밖 배포 환경: 서비스 계정 JSON 전체를 한 줄 base64로 인코딩
# 값이 없으면 로컬 gcloud ADC 또는 GCP 런타임 서비스 계정을 사용
GCS_SERVICE_ACCOUNT_KEY_BASE64=

# PDF Processor
PDF_PROCESSOR_CONCURRENCY=1
PDF_PROCESSOR_CONTEXT_LENGTH=500
PDF_PROCESSOR_LLM_TIMEOUT=120
# Pass 1 page LLM fallback ratio (0–1). Exceeding this marks the document failed.
PDF_PROCESSOR_PASS1_MAX_FAILURE_RATIO=0.1
PDF_PROCESSOR_POLL_INTERVAL_MS=2000
# PDF_PROCESSOR_STALE_PROCESSING_MS=1800000

# LLM Provider: letsur (default) | openrouter
LLM_PROVIDER=letsur

# Letsur AI Gateway (LLM_PROVIDER=letsur)
LETSUR_AI_GATEWAY_BASE_URL=https://gw.letsur.ai/v1
LETSUR_AI_GATEWAY_API_KEY=your-letsur-ai-gateway-api-key
# LIGHT: 선별용(경로/chunk/문서 선택), NORMAL: 단순 응답, HEAVY: 최종 답변 생성
LETSUR_AI_GATEWAY_MODEL_LIGHT=gpt-4o-mini
LETSUR_AI_GATEWAY_MODEL_NORMAL=gpt-4o-mini
LETSUR_AI_GATEWAY_MODEL_HEAVY=gpt-4o-mini
LETSUR_AI_GATEWAY_X_TITLE=GIST_CHATBOT

# OpenRouter (LLM_PROVIDER=openrouter 일 때만 필수)
OPEN_ROUTER_API_KEY=your-openrouter-api-key
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_MODEL_LIGHT=google/gemini-2.0-flash-001
OPEN_ROUTER_MODEL_NORMAL=google/gemini-2.0-flash-001
OPEN_ROUTER_MODEL_HEAVY=openai/gpt-4o
OPEN_ROUTER_X_TITLE=APP_NAME

# Embedding (벡터 검색)
# 비어 있으면 벡터 검색이 비활성화되고 기존 LLM 선별로 폴백한다.
# 값이 없으면 LETSUR_AI_GATEWAY_BASE_URL / _API_KEY 를 대신 사용한다.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 모델을 바꾸면 벡터 차원이 달라질 수 있다. document_chunks.embedding 은
# vector(3072) 고정이므로, 차원이 다른 모델로 바꾸려면 마이그레이션이 필요하다.
EMBEDDING_MODEL=text-embedding-3-large
# 벡터 검색 kill-switch. false 면 항상 기존 LLM 선별을 사용한다.
EMBEDDING_RETRIEVAL_ENABLED=true
# 코사인 거리 상한. 이보다 먼 후보는 관련 있다고 보지 않는다.
EMBEDDING_MAX_DISTANCE=0.70

# 벡터 검색 튜닝 (기본값은 src/retrieval/retrieval.constants.ts 참고)
RETRIEVAL_DENSE_CANDIDATE_LIMIT=20
RETRIEVAL_STRONG_DISTANCE=0.55
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2

# Swagger API 문서 잠금
SWAGGER_USER=docs_admin
SWAGGER_PASSWORD=your-secure-password